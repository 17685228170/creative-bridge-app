# 创意桥 - 环境变量配置

# 数据库
DATABASE_URL="file:./dev.db"

# JWT 密钥（生产环境请更换为随机字符串）
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# 文件上传配置
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="104857600"

# 应用配置
NEXT_PUBLIC_APP_NAME="创意桥"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# 蚂蚁链配置（可选，用于真实区块链存证）
# ============================================

# 是否启用真实蚂蚁链（true/false）
ANTCHAIN_ENABLED="false"

# 蚂蚁链 Access Key（在蚂蚁链控制台获取）
ANTCHAIN_ACCESS_KEY=""

# 蚂蚁链 Secret Key
ANTCHAIN_SECRET_KEY=""

# 蚂蚁链 API 端点
ANTCHAIN_ENDPOINT="https://openapi.antchain.antgroup.com/gateway.do"

# 存证模板 ID（在蚂蚁链控制台创建模板后获取）
ANTCHAIN_TEMPLATE_ID=""

# ============================================
# 支付配置（可选，用于VIP购买和提现）
# ============================================

# 支付宝配置
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"

# 微信支付配置
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_APP_ID=""
WECHAT_PAY_API_KEY=""
WECHAT_PAY_NOTIFY_URL=""

# ============================================
# 第三方登录配置（可选）
# ============================================

# 微信登录
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# 短信服务
SMS_ACCESS_KEY=""
SMS_SECRET_KEY=""
SMS_SIGN_NAME=""

# ============================================
# 邮件服务配置（可选）
# ============================================

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
