# 创意桥 - 环境变量配置

# 数据库 (Vercel PostgreSQL 或本地 SQLite)
# 开发环境使用 SQLite
DATABASE_URL="file:./dev.db"

# 生产环境使用 PostgreSQL (Vercel)
# DATABASE_URL="postgresql://user:password@host:port/database"

# JWT 密钥（生产环境请更换为随机字符串）
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# 文件上传配置
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="104857600"

# 应用配置
NEXT_PUBLIC_APP_NAME="创意桥"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# 蚂蚁链配置（可选，用于真实区块链存证）
# ============================================
ANTCHAIN_ENABLED="false"
ANTCHAIN_ACCESS_KEY=""
ANTCHAIN_SECRET_KEY=""
ANTCHAIN_ENDPOINT="https://openapi.antchain.antgroup.com/gateway.do"
ANTCHAIN_TEMPLATE_ID=""

# ============================================
# 支付配置（可选，用于VIP购买和提现）
# ============================================
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"

WECHAT_PAY_MCH_ID=""
WECHAT_PAY_APP_ID=""
WECHAT_PAY_API_KEY=""
WECHAT_PAY_NOTIFY_URL=""
